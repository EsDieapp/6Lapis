{
  "name": "6lapis",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "exports": {
    "BotState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
